{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Crawler": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Crawler": {
    "ConcurrentMessageLimit": 8,
    "MaxResponseBytes": 2097152,
    "MaxStoredLinksPerPage": 1000,
    "UserAgent": "AltevaCrawler/1.0",
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 45,
    "MaxRetryAttempts": 3,
    "MaxRedirects": 5
  }
}
