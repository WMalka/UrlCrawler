{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Crawler": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "CrawlJobs": {
    "DefaultMaxDepth": 2,
    "MaxAllowedDepth": 5,
    "MaxPagesPerJob": 200,
    "MaxHistoryPageSize": 100
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
